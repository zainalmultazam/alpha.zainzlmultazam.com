APP_NAME=Alpha
APP_DOMAIN=alpha.zainalmultazam.com
APP_ENV=production
DEFAULT_CAPITAL=50000000
DEFAULT_MAX_RISK_PCT=1.0
ACCESS_PIN=1234

# Universal Multi-Provider LLM Settings ("Tanya Alpha AI")
# Provider options: gemini (default), openai, deepseek, groq, openrouter, custom
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
# LLM_BASE_URL=https://api.groq.com/openai/v1  # Opsional jika menggunakan custom proxy

# Telegram Bot (Opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_TELEGRAM_ALERTS=false
